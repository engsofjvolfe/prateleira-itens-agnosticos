{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "regras.schema.json",
  "type": "object",
  "required": ["versao_schema", "partes", "regras"],
  "additionalProperties": false,
  "properties": {
    "versao_schema": { "const": 1 },
    "partes": { "type": "object", "additionalProperties": { "$ref": "#/$defs/texto" } },
    "regras": { "type": "array", "items": { "$ref": "#/$defs/regra" } }
  },
  "$defs": {
    "texto": { "type": "string", "minLength": 1 },
    "regra": {
      "type": "object",
      "required": ["nome", "ferramenta", "forma", "fonte"],
      "additionalProperties": false,
      "properties": {
        "nome": { "$ref": "#/$defs/texto" },
        "ferramenta": { "$ref": "#/$defs/texto" },
        "forma": { "$ref": "#/$defs/texto" },
        "fonte": {
          "type": "object",
          "required": ["arquivo", "trecho"],
          "additionalProperties": false,
          "properties": { "arquivo": { "$ref": "#/$defs/texto" }, "trecho": { "$ref": "#/$defs/texto" } }
        },
        "documentada": {
          "type": "object",
          "required": ["arquivo", "texto"],
          "additionalProperties": false,
          "properties": { "arquivo": { "$ref": "#/$defs/texto" }, "texto": { "$ref": "#/$defs/texto" } }
        }
      }
    }
  }
}
