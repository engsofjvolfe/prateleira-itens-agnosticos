{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "regras.schema.json",
  "type": "object",
  "required": ["fora", "marcas", "grupos", "documentos"],
  "additionalProperties": true,
  "properties": {
    "fora": { "type": "array", "items": { "$ref": "#/$defs/fora" } },
    "marcas": { "type": "array", "items": { "$ref": "#/$defs/marca" } },
    "grupos": { "type": "array", "items": { "$ref": "#/$defs/grupo" } },
    "documentos": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/documento" } }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1 },
    "nome": { "type": "string", "minLength": 1 },
    "textos": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "textos_ou_nenhum": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "fora": {
      "type": "object",
      "required": ["id", "nome", "tipos"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "nome": { "$ref": "#/$defs/nome" },
        "tipos": { "$ref": "#/$defs/textos" }
      }
    },
    "marca": {
      "type": "object",
      "required": ["id", "nome", "texto", "papeis"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "nome": { "$ref": "#/$defs/nome" },
        "texto": { "type": "string", "minLength": 1 },
        "papeis": { "$ref": "#/$defs/textos" }
      }
    },
    "grupo": {
      "type": "object",
      "required": ["id", "nome"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "nome": { "$ref": "#/$defs/nome" },
        "pelo_assunto": { "type": "boolean" }
      }
    },
    "documento": {
      "type": "object",
      "required": ["id", "nome"],
      "additionalProperties": true,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "nome": { "$ref": "#/$defs/nome" },
        "todos": { "type": "boolean" },
        "grupos": { "$ref": "#/$defs/textos_ou_nenhum" },
        "caminhos": { "$ref": "#/$defs/textos_ou_nenhum" }
      }
    }
  }
}
