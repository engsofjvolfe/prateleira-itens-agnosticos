{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "confere-changelog.schema.json",
  "type": "object",
  "required": ["versao_schema", "nao_publicado", "removida", "tipos", "fim_do_item"],
  "additionalProperties": false,
  "properties": {
    "versao_schema": { "const": 1 },
    "nao_publicado": { "$ref": "comum.schema.json#/$defs/linha" },
    "removida": { "$ref": "comum.schema.json#/$defs/linha" },
    "tipos": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "comum.schema.json#/$defs/linha" } },
    "fim_do_item": { "$ref": "comum.schema.json#/$defs/linha" },
    "links": {
      "type": "object",
      "required": ["nao_publicado", "versao", "primeira"],
      "additionalProperties": false,
      "properties": {
        "nao_publicado": { "$ref": "comum.schema.json#/$defs/linha" },
        "versao": { "$ref": "comum.schema.json#/$defs/linha" },
        "primeira": { "$ref": "comum.schema.json#/$defs/linha" }
      }
    }
  }
}
