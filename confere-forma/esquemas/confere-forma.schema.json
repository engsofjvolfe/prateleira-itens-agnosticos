{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "confere-forma.schema.json",
  "type": "object",
  "required": ["versao_schema", "secao", "divisor", "fecho", "italico", "palavras"],
  "additionalProperties": false,
  "properties": {
    "versao_schema": { "const": 2 },
    "lacunas": { "type": "array", "items": { "$ref": "#/$defs/lacuna" } },
    "secao": { "$ref": "#/$defs/expressao" },
    "comeco_das_secoes": { "$ref": "#/$defs/expressao" },
    "divisor": { "$ref": "#/$defs/expressao" },
    "fecho": {
      "type": "object",
      "required": ["abre", "continua"],
      "additionalProperties": false,
      "properties": {
        "abre": { "$ref": "#/$defs/expressao" },
        "continua": { "$ref": "#/$defs/expressao" }
      }
    },
    "siglas": {
      "type": "object",
      "required": ["padrao", "fora_de"],
      "additionalProperties": false,
      "properties": {
        "padrao": { "$ref": "#/$defs/expressao" },
        "antes": { "$ref": "#/$defs/expressao" },
        "depois": { "$ref": "#/$defs/expressao" },
        "fora_de": { "$ref": "#/$defs/expressao" },
        "trechos_fora": { "$ref": "#/$defs/expressao" }
      }
    },
    "italico": {
      "type": "object",
      "required": ["nomes", "marcas", "fora_de"],
      "additionalProperties": false,
      "properties": {
        "nomes": { "type": "array", "items": { "$ref": "#/$defs/texto" } },
        "marcas": { "type": "array", "items": { "$ref": "#/$defs/texto" } },
        "fora_de": { "$ref": "#/$defs/expressao" }
      }
    },
    "palavras": {
      "type": "object",
      "required": ["fora_de", "minimo", "maximo"],
      "additionalProperties": false,
      "properties": {
        "fora_de": { "$ref": "#/$defs/expressao" },
        "minimo": { "type": "integer", "minimum": 0 },
        "maximo": { "type": "integer", "minimum": 0 }
      }
    }
  },
  "$defs": {
    "texto": { "type": "string", "minLength": 1 },
    "expressao": { "type": "string", "minLength": 1 },
    "lacuna": {
      "type": "object",
      "required": ["marca", "padrao"],
      "additionalProperties": false,
      "properties": {
        "marca": { "$ref": "comum.schema.json#/$defs/linha" },
        "padrao": { "$ref": "#/$defs/expressao" }
      }
    }
  }
}
