{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "molde.schema.json",
  "type": ["object", "boolean"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "const": "https://json-schema.org/draft/2020-12/schema" },
    "$id": { "type": "string" },
    "$defs": { "type": "object", "additionalProperties": { "$ref": "#" } },
    "$comment": { "type": "string" },
    "$ref": { "type": "string", "pattern": "^#(/\\$defs/[^/]+)?$" },
    "title": { "type": "string" },
    "description": { "type": "string" },
    "default": true,
    "examples": { "type": "array" },
    "type": { "type": ["string", "array"], "items": { "type": "string" }, "minItems": 1, "uniqueItems": true },
    "const": true,
    "enum": { "type": "array", "minItems": 1 },
    "minLength": { "$ref": "#/$defs/contagem" },
    "maxLength": { "$ref": "#/$defs/contagem" },
    "pattern": { "type": "string" },
    "minimum": { "type": "number" },
    "maximum": { "type": "number" },
    "minItems": { "$ref": "#/$defs/contagem" },
    "maxItems": { "$ref": "#/$defs/contagem" },
    "uniqueItems": { "type": "boolean" },
    "items": { "$ref": "#" },
    "required": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "properties": { "type": "object", "additionalProperties": { "$ref": "#" } },
    "additionalProperties": { "$ref": "#" },
    "minProperties": { "$ref": "#/$defs/contagem" },
    "maxProperties": { "$ref": "#/$defs/contagem" },
    "allOf": { "type": "array", "minItems": 1, "items": { "$ref": "#" } },
    "if": { "$ref": "#" },
    "then": { "$ref": "#" },
    "else": { "$ref": "#" }
  },
  "$defs": {
    "contagem": { "type": "integer", "minimum": 0 }
  }
}
