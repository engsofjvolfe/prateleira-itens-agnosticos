{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dicionario-das-duvidas.schema.json",
  "type": "object",
  "required": ["versao_schema", "titulo", "codigo", "partes"],
  "additionalProperties": false,
  "properties": {
    "versao_schema": { "const": 1 },
    "titulo": { "$ref": "#/$defs/marca" },
    "codigo": {
      "type": "object",
      "required": ["abre", "fecha", "entre"],
      "additionalProperties": false,
      "properties": {
        "abre": { "$ref": "#/$defs/marca" },
        "fecha": { "$ref": "#/$defs/marca" },
        "entre": { "$ref": "#/$defs/marca" }
      }
    },
    "partes": {
      "type": "object",
      "required": ["separador", "formas", "tamanhos"],
      "additionalProperties": false,
      "properties": {
        "separador": { "$ref": "#/$defs/marca" },
        "formas": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "tamanhos": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": { "type": "integer", "minimum": 1 }
        }
      }
    }
  },
  "$defs": {
    "marca": { "type": "string", "pattern": "^[^\\n\\r]+(?![\\s\\S])" }
  }
}
