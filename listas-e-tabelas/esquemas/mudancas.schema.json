{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mudancas.schema.json",
  "type": "object",
  "required": ["versao_schema"],
  "minProperties": 2,
  "additionalProperties": false,
  "properties": {
    "versao_schema": { "const": 1 },
    "listas": { "type": "object", "minProperties": 1, "additionalProperties": { "type": "array", "minItems": 1 } },
    "tabelas": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/troca" } }
    }
  },
  "$defs": {
    "troca": { "type": "object", "minProperties": 2, "additionalProperties": { "type": "string" } }
  }
}
